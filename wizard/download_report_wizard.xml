<odoo>
    <record id="view_sb_trial_balance_wizard_form" model="ir.ui.view">
        <field name="name">sb.trial.balance.wizard.form</field>
        <field name="model">sb.trial.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Trial Balance">
                <group>
                    <group>
                        <field name="display_accounts" widget="radio"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                        <field name="note_template"/>
                    </group>
                </group>
                <footer>
                    <button string="Export" type="object" name="action_export" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sb_trial_balance_wizard" model="ir.actions.act_window">
        <field name="name">Trial Balance Wizard</field>
        <field name="res_model">sb.trial.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sb_trial_balance_wizard_form"/>
        <field name="target">new</field>
    </record>
    
</odoo>
