<odoo>
    <record id="view_account_account_form_inherit_related_notes" model="ir.ui.view">
        <field name="name">account.account.form.inherit.related.notes</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Related Notes">
                    <field name="related_notes">
                        <list editable="bottom">
                            <field name="note_template_id"/>
                            <field name="note_id"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
